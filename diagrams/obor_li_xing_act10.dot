  foot [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1046"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#AAB4C8" CELLPADDING="9" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP" WIDTH="480"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1B2B48"><B>Citas clave por concepto</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   instrucción 1</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="4"> </FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP" WIDTH="223" CELLPADDING="0"><FONT POINT-SIZE="10.5" COLOR="#262A31"><FONT COLOR="#C8102E"><B>Sobrecapacidad</B></FONT><FONT COLOR="#8A8F98"><I>  (Xing, 2019, p. 37)</I></FONT><BR ALIGN="LEFT"/><I>“the OBOR initiative is intended to</I><BR ALIGN="LEFT"/><I>transfer overproduction and overcapacity</I><BR ALIGN="LEFT"/><I>to new markets in neighboring countries”</I><BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP" WIDTH="223" CELLPADDING="0"><FONT POINT-SIZE="10.5" COLOR="#262A31"><FONT COLOR="#C8102E"><B>Hegemonía</B></FONT><FONT COLOR="#8A8F98"><I>  (Xing, 2019, p. 32)</I></FONT><BR ALIGN="LEFT"/><I>“the logical nexus between the</I><BR ALIGN="LEFT"/><I>accumulation and consolidation of China’s</I><BR ALIGN="LEFT"/><I>internal achievement (hegemony) and its</I><BR ALIGN="LEFT"/><I>inevitable outward expansion”</I><BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD COLSPAN="3" HEIGHT="10"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP" WIDTH="223" CELLPADDING="0"><FONT POINT-SIZE="10.5" COLOR="#262A31"><FONT COLOR="#C8102E"><B>Centro y periferia</B></FONT><FONT COLOR="#8A8F98"><I>  (Xing, 2019, p. 45)</I></FONT><BR ALIGN="LEFT"/><I>“while China is successfully moving</I><BR ALIGN="LEFT"/><I>toward the core, it still needs a</I><BR ALIGN="LEFT"/><I>periphery”</I><BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="14"> </TD><TD ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP" WIDTH="223" CELLPADDING="0"><FONT POINT-SIZE="10.5" COLOR="#262A31"><FONT COLOR="#C8102E"><B>Margen de maniobra</B></FONT><FONT COLOR="#8A8F98"><I>  (Xing, 2019, p. 46)</I></FONT><BR ALIGN="LEFT"/><I>“‘Room for maneuver’ refers to the</I><BR ALIGN="LEFT"/><I>external conditions for the ‘upward</I><BR ALIGN="LEFT"/><I>mobility’ in the world capitalist economy</I><BR ALIGN="LEFT"/><I>that is conducive to internal</I><BR ALIGN="LEFT"/><I>development”</I><BR ALIGN="LEFT"/></FONT></TD></TR></TABLE></TD><TD WIDTH="10"> </TD><TD STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#AAB4C8" CELLPADDING="9" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP" WIDTH="262"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13" COLOR="#1B2B48"><B>Glosario EN → ES</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="4"> </FONT><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#0E6A75"><I>overcapacity</I></FONT></TD><TD WIDTH="8"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#262A31">sobrecapacidad productiva</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#0E6A75"><I>room for maneuver</I></FONT></TD><TD WIDTH="8"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#262A31">margen de maniobra</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#0E6A75"><I>upward mobility</I></FONT></TD><TD WIDTH="8"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#262A31">ascenso en la jerarquía</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#0E6A75"><I>rule-follower</I></FONT></TD><TD WIDTH="8"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#262A31">sigue las reglas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#0E6A75"><I>rule-shaper / -maker</I></FONT></TD><TD WIDTH="8"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#262A31">influye en las reglas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#0E6A75"><I>promotion by invitation</I></FONT></TD><TD WIDTH="8"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#262A31">promoción por invitación</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#0E6A75"><I>seizing the chance</I></FONT></TD><TD WIDTH="8"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#262A31">aprovechar la oportunidad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#0E6A75"><I>war of position</I></FONT></TD><TD WIDTH="8"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#262A31">guerra de posición</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#0E6A75"><I>SDR</I></FONT></TD><TD WIDTH="8"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#262A31">DEG del FMI</FONT></TD></TR></TABLE></TD><TD WIDTH="10"> </TD><TD STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#AAB4C8" CELLPADDING="9" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP" WIDTH="282"><FONT POINT-SIZE="13" COLOR="#1B2B48"><B>Referencia (APA 7)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="4"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#262A31">Xing, L. (2019). Understanding the multiple facets<BR ALIGN="LEFT"/>&#160;&#160;&#160;of China’s “One Belt One Road” initiative. En<BR ALIGN="LEFT"/>&#160;&#160;&#160;L. Xing (Ed.), <I>Mapping China’s ‘One Belt One</I><BR ALIGN="LEFT"/>&#160;&#160;&#160;<I>Road’ initiative</I> (pp. 29–56). Palgrave Macmillan.<BR ALIGN="LEFT"/>&#160;&#160;&#160;https://doi.org/10.1007/978-3-319-92201-0_2</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="6"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#965800"><B>Ojo con las fechas:</B></FONT><FONT POINT-SIZE="9" COLOR="#262A31"> libro 2019; videos 2021 y</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#262A31">2024. Separa lo observado de lo pronosticado.</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="6"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#262A31"><FONT COLOR="#C8102E"><B>━━▶</B></FONT>  cadena ① → ④<BR ALIGN="LEFT"/><FONT COLOR="#6B7280"><B>──▶</B></FONT>  relación explicada en el capítulo<BR ALIGN="LEFT"/><FONT COLOR="#D9B100"><B>┄┄</B></FONT>  pregunta de la actividad</FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
  }
  header -> chain [style=invis, weight=100];
  chain -> b1r1 [style=invis, weight=100];
  b1r1:L:s -> b1r2:L:n [style=invis, weight=100];
  b1r1:R:s -> b1r2:R:n [style=invis, weight=100];
  b1r2:L:s -> b2r1:L:n [style=invis, weight=100];
  b1r2:R:s -> b3r1:R:n [style=invis, weight=100];
  b2r1:L:s -> b2r2:L:n [style=invis, weight=100];
  b2r2:L:s -> b2r3:L:n [style=invis, weight=100];
  b2r3:L:s -> ccr1:L:n [style=invis, weight=100];
  ccr1:L:s -> ccr2:L:n [style=invis, weight=100];
  ccr2:L:s -> foot:L:n [style=invis, weight=100];
  b3r1:R:s -> b3r2:R:n [style=invis, weight=100];
  b3r2:R:s -> b3r3:R:n [style=invis, weight=100];
  b3r3:R:s -> rrr1:R:n [style=invis, weight=100];
  rrr1:R:s -> rrr2:R:n [style=invis, weight=100];
  rrr2:R:s -> foot:R:n [style=invis, weight=100];
  { rank=same; b2r1; b3r1; }
  { rank=same; b2r2; b3r2; }
