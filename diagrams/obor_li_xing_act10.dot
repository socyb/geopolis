  b3r3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="501.0" HEIGHT="95"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD PORT="kau" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#93C9CF" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="140"><FONT POINT-SIZE="9" COLOR="#0E6A75"><B>COOPERACIÓN</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>pp. 47, 49–50</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#0E6A75"><B>Kautsky (1914)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Ultraimperialismo:<BR ALIGN="LEFT"/>&#160;&#160;&#160;cártel de<BR ALIGN="LEFT"/>&#160;&#160;&#160;capitales; AIIB +<BR ALIGN="LEFT"/>&#160;&#160;&#160;capital global.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="23" VALIGN="MIDDLE"><FONT POINT-SIZE="17" COLOR="#0E6A75">⇄</FONT><BR/><FONT POINT-SIZE="8" COLOR="#0E6A75"><I>vs.</I></FONT></TD><TD PORT="len" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#93C9CF" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="140"><FONT POINT-SIZE="9" COLOR="#0E6A75"><B>RIVALIDAD</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>pp. 47–48, 50</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#0E6A75"><B>Lenin (1917)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Competencia entre<BR ALIGN="LEFT"/>&#160;&#160;&#160;centros → conflicto<BR ALIGN="LEFT"/>&#160;&#160;&#160;oligopólico.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="20" VALIGN="MIDDLE"><FONT POINT-SIZE="17" COLOR="#0E6A75">→</FONT></TD><TD PORT="two" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#93C9CF" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="176.0"><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>pp. 48–50 · Fig. 2.6</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#0E6A75"><B>Las dos caras de China</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Periferia explotada y<BR ALIGN="LEFT"/>&#160;&#160;&#160;centro «Norte»: bonos de<BR ALIGN="LEFT"/>&#160;&#160;&#160;EE. UU., yuan en los DEG.</FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
