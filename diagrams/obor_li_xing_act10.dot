  b2r1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="501" HEIGHT="98"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD PORT="mat" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E6C48F" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="154"><FONT POINT-SIZE="9" COLOR="#965800"><B>ESFERA 1</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   pp. 39, 49</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#965800"><B>Capacidades</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#965800"><B>materiales</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Capital, manufactura,<BR ALIGN="LEFT"/>&#160;&#160;&#160;infraestructura.<BR ALIGN="LEFT"/>• Reservas: US$3.2<BR ALIGN="LEFT"/>&#160;&#160;&#160;billones (2016).</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="9"> </TD><TD PORT="ide" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E6C48F" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="154"><FONT POINT-SIZE="9" COLOR="#965800"><B>ESFERA 2</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   pp. 42–44</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#965800"><B>Ideas · poder</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#965800"><B>blando</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• «Comunidad de destino<BR ALIGN="LEFT"/>&#160;&#160;&#160;común», Sueño chino,<BR ALIGN="LEFT"/>&#160;&#160;&#160;Consenso de Beijing.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="9"> </TD><TD PORT="ins" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E6C48F" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="173"><FONT POINT-SIZE="9" COLOR="#965800"><B>② ESFERA 3</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>pp. 40–42 · n. 2–4</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#C8102E"><B>Instituciones</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• AIIB (2015), Banco BRICS<BR ALIGN="LEFT"/>&#160;&#160;&#160;(China: 41 %), Fondo de<BR ALIGN="LEFT"/>&#160;&#160;&#160;la Ruta de la Seda<BR ALIGN="LEFT"/>&#160;&#160;&#160;(US$40 mil mill.).</FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
  b2r2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="501" HEIGHT="87"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD PORT="bw" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E6C48F" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="211"><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>pp. 41–42</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#965800"><B>Crisis de Bretton Woods</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• BM, FMI y OMC pierden<BR ALIGN="LEFT"/>&#160;&#160;&#160;funcionalidad, alcance,<BR ALIGN="LEFT"/>&#160;&#160;&#160;legitimidad y autoridad tras<BR ALIGN="LEFT"/>&#160;&#160;&#160;2008.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="50" VALIGN="MIDDLE"><FONT POINT-SIZE="17" COLOR="#965800">→</FONT><BR/><FONT POINT-SIZE="8" COLOR="#965800"><I>abre paso</I></FONT></TD><TD PORT="heg" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E6C48F" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="238"><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>p. 40 · n. 8</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#965800"><B>Bloque histórico alternativo</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• «Guerra de posición» (Gramsci):<BR ALIGN="LEFT"/>&#160;&#160;&#160;disputa lenta por normas e<BR ALIGN="LEFT"/>&#160;&#160;&#160;influencia.<BR ALIGN="LEFT"/>• China fija y difunde normas.</FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
  b2r3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="501" HEIGHT="95"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD PORT="rev" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E6C48F" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="244"><FONT POINT-SIZE="9" COLOR="#965800"><B>DEBATE</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   pp. 30–31, 42</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#965800"><B>¿Statu quo o revisionista?</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• De «free-rider vs. stakeholder» a<BR ALIGN="LEFT"/>&#160;&#160;&#160;«statu quo vs. revisionista»: el<BR ALIGN="LEFT"/>&#160;&#160;&#160;minilateralismo como reto a Bretton<BR ALIGN="LEFT"/>&#160;&#160;&#160;Woods.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="10"> </TD><TD PORT="q2" STYLE="rounded" BGCOLOR="#FFF4BD" BORDER="1" COLOR="#D9B100" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="245"><FONT POINT-SIZE="9" COLOR="#6E5500"><B>? PREGUNTA DE LA ACTIVIDAD</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#6E5500"><I>¿Qué tendría que ocurrir para que estos<BR ALIGN="LEFT"/>recursos se tradujeran en capacidad de<BR ALIGN="LEFT"/>orientar el orden internacional?</I></FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
  }
