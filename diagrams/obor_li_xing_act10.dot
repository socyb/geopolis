  rrr1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="682.0" HEIGHT="86"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD PORT="arte" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#9DCA9F" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="216" HREF="https://www.youtube.com/watch?v=k9xZ3uESyls" TARGET="_blank" TITLE="ARTE.tv (2021)"><FONT POINT-SIZE="9" COLOR="#2E6B31"><B>▶ VIDEO 1 · SITÚA</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   11:59 min</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#2E6B31"><B>ARTE.tv (2021)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• «China: la nueva ruta de la<BR ALIGN="LEFT"/>&#160;&#160;&#160;seda».<BR ALIGN="LEFT"/>• ¿Qué liga una obra con la<BR ALIGN="LEFT"/>&#160;&#160;&#160;influencia de quien la financia?</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="10"> </TD><TD PORT="bbc" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#9DCA9F" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="227" HREF="https://www.youtube.com/watch?v=IdHq0TuDdT4" TARGET="_blank" TITLE="BBC Mundo (2024): Chancay"><FONT POINT-SIZE="9" COLOR="#2E6B31"><B>▶ VIDEO 2 · APLICA</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   5:52 min</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#2E6B31"><B>BBC Mundo (2024): Chancay</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Caso posterior al libro.<BR ALIGN="LEFT"/>• ¿Más exportaciones o movilidad<BR ALIGN="LEFT"/>&#160;&#160;&#160;ascendente? Separa expectativas de<BR ALIGN="LEFT"/>&#160;&#160;&#160;resultados.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="10"> </TD><TD PORT="fn" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#9DCA9F" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="217.0"><FONT POINT-SIZE="9" COLOR="#2E6B31"><B>ACTIVIDAD 5</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   redes</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#2E6B31"><B>Farrell y Newman</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Poder de controlar cuellos de<BR ALIGN="LEFT"/>&#160;&#160;&#160;botella.<BR ALIGN="LEFT"/>• ¿Cuándo una ruta reduce la<BR ALIGN="LEFT"/>&#160;&#160;&#160;dependencia y cuándo crea otra?</FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
  rrr2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="682.0" HEIGHT="107"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD PORT="aut" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#9DCA9F" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="213"><FONT POINT-SIZE="9" COLOR="#2E6B31"><B>↑ AUTONOMÍA SI…</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   pp. 32, 46</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#2E6B31"><B>El receptor aprovecha la</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#2E6B31"><B>oportunidad</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Negocia tecnología, empleo y<BR ALIGN="LEFT"/>&#160;&#160;&#160;proveedores locales.<BR ALIGN="LEFT"/>• Diversifica socios; decide<BR ALIGN="LEFT"/>&#160;&#160;&#160;sobre el nodo.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="20" VALIGN="MIDDLE"><FONT POINT-SIZE="17" COLOR="#2E6B31">⇄</FONT></TD><TD PORT="q4" STYLE="rounded" BGCOLOR="#FFF4BD" BORDER="1" COLOR="#D9B100" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="213"><FONT POINT-SIZE="9" COLOR="#6E5500"><B>? PARA DISCUSIÓN EN CLASE</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#6E5500"><I>¿Qué condiciones ampliarían la<BR ALIGN="LEFT"/>autonomía de los receptores y<BR ALIGN="LEFT"/>cuáles profundizarían su<BR ALIGN="LEFT"/>dependencia?</I></FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="20" VALIGN="MIDDLE"><FONT POINT-SIZE="17" COLOR="#B3261E">⇄</FONT></TD><TD PORT="dep" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E8AFA8" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="214.0"><FONT POINT-SIZE="9" COLOR="#B3261E"><B>↓ DEPENDENCIA SI…</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   pp. 31, 45</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#B3261E"><B>El receptor queda como</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#B3261E"><B>periferia</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Solo exporta materias primas.<BR ALIGN="LEFT"/>• Quien financia u opera controla<BR ALIGN="LEFT"/>&#160;&#160;&#160;el cuello de botella.</FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
  }
