  { rank=same; ccr1; rrr1; }
  { rank=same; ccr2; rrr2; }
  b2r1 -> b3r1 [style=invis];
  ccr1 -> rrr1 [style=invis];
  b1r1:hub:s -> b1r2:val:n [color="#B3261E", penwidth=1.2, style=solid, xlabel=<<FONT POINT-SIZE="8" COLOR="#B3261E"><I>base regional</I></FONT>>];
  b1r2:val:s -> b2r1:ins:n [color="#C8102E", penwidth=3.0, style=solid, arrowsize=0.9];
  b2r1:mat:s -> b2r2:heg:n [color="#965800", penwidth=1.3, style=solid];
  b2r1:ins:s -> b2r2:heg:n [color="#965800", penwidth=1.3, style=solid];
  b2r1:ide:s -> b2r2:heg:n [color="#965800", penwidth=1.3, style=solid];
  b2r2:bw:s -> b2r3:rev:n [color="#965800", penwidth=1.0, style=dashed, arrowhead=none];
  b2r2:heg:s -> b2r3:q2:n [color="#D9B100", penwidth=1.3, style=dashed, arrowhead=none];
  b3r1:ws:s -> b3r2:inv:n [color="#0E6A75", penwidth=1.3, style=solid, xlabel=<<FONT POINT-SIZE="8" COLOR="#0E6A75"><I>ciclos</I></FONT>>];
  rrr1:bbc:s -> rrr2:q4:n [color="#D9B100", penwidth=1.3, style=dashed, arrowhead=none];
  rrr1:fn:s -> rrr2:dep:n [color="#B3261E", penwidth=1.0, style=dashed];
