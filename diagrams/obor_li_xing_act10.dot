<FONT POINT-SIZE="10" COLOR="#FFFFFF"><B>Franja</B></FONT><FONT POINT-SIZE="10" COLOR="#C9D3E6"> = rutas terrestres: Asia Central y Occidental, Medio Oriente → Europa    </FONT><FONT POINT-SIZE="10" COLOR="#FFFFFF"><B>Ruta</B></FONT><FONT POINT-SIZE="10" COLOR="#C9D3E6"> = rutas marítimas: puertos chinos → África → Suez → Mediterráneo</FONT><BR ALIGN="LEFT"/>
