  ccr1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="320" HEIGHT="86"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD PORT="uni" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#B3B5D3" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="318"><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>pp. 50–51</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#4B4E79"><B>«Consecuencia no intencionada»</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Receptor de capital → exportador.<BR ALIGN="LEFT"/>• Rule-follower → rule-maker.<BR ALIGN="LEFT"/>• Periferia → centro emergente.</FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
  ccr2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="320" HEIGHT="107"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD PORT="rie" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#B3B5D3" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="318"><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>p. 51</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#4B4E79"><B>Riesgos y límites</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Inestabilidad: Asia del Sur, Central y Medio<BR ALIGN="LEFT"/>&#160;&#160;&#160;Oriente.<BR ALIGN="LEFT"/>• Oportunidades desiguales: Pakistán ≫ India.<BR ALIGN="LEFT"/>• Poca sensibilidad religiosa, cultural, étnica y<BR ALIGN="LEFT"/>&#160;&#160;&#160;ambiental.<BR ALIGN="LEFT"/>• Modelo estatal difícil de replicar.</FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
