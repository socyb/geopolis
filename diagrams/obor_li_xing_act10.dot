  b1r1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1046"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD PORT="tao" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E8AFA8" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="231"><FONT POINT-SIZE="9" COLOR="#B3261E"><B>1980s · <FONT FACE="WenQuanYi Zen Hei">韬光养晦</FONT></B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   pp. 32–34 · n. 5</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#B3261E"><B>Tao Guang Yang Hui</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Deng: «ocultar capacidades y<BR ALIGN="LEFT"/>&#160;&#160;&#160;esperar el momento».<BR ALIGN="LEFT"/>• Se integra a la división regional<BR ALIGN="LEFT"/>&#160;&#160;&#160;del trabajo: <B>rule-follower</B>.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="45" VALIGN="MIDDLE"><FONT POINT-SIZE="17" COLOR="#B3261E">→</FONT><BR/><FONT POINT-SIZE="8" COLOR="#B3261E"><I>transita</I></FONT></TD><TD PORT="you" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E8AFA8" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="231"><FONT POINT-SIZE="9" COLOR="#B3261E"><B>2010s · <FONT FACE="WenQuanYi Zen Hei">有所作为</FONT></B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   p. 33 · Fig. 2.1</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#B3261E"><B>You Suo Zuo Wei</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• «Lograr algo»: go out / go global.<BR ALIGN="LEFT"/>• AIIB, finanzas, Sueño chino:<BR ALIGN="LEFT"/>&#160;&#160;&#160;<B>rule-shaper</B>.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="22"> </TD><TD PORT="gee" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E8AFA8" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="231"><FONT POINT-SIZE="9" COLOR="#B3261E"><B>MODELO REGIONAL</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   pp. 34–35 · Fig. 2.2</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#B3261E"><B>Gansos voladores (Akamatsu)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Asia en capas, Japón al frente.<BR ALIGN="LEFT"/>• China vuela en varias capas: costa<BR ALIGN="LEFT"/>&#160;&#160;&#160;high-tech, interior intensivo en<BR ALIGN="LEFT"/>&#160;&#160;&#160;mano de obra.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="50" VALIGN="MIDDLE"><FONT POINT-SIZE="17" COLOR="#B3261E">→</FONT><BR/><FONT POINT-SIZE="8" COLOR="#B3261E"><I>da paso a</I></FONT></TD><TD PORT="hub" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E8AFA8" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="234"><FONT POINT-SIZE="9" COLOR="#B3261E"><B>2010s</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   pp. 35–36 · Figs. 2.3–2.4</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#B3261E"><B>Orden regional centrado en</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#B3261E"><B>China</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Integrador: «Made-in-Asia» →<BR ALIGN="LEFT"/>&#160;&#160;&#160;«Made-in-China».<BR ALIGN="LEFT"/>• 1.er socio comercial de Asia<BR ALIGN="LEFT"/>&#160;&#160;&#160;Oriental.</FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
  b1r2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1046"><TR><TD PORT="L" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD><TD PORT="mod" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E8AFA8" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="198"><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>p. 29</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#B3261E"><B>Modelo chino</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Infraestructura interna +<BR ALIGN="LEFT"/>&#160;&#160;&#160;promoción de exportaciones.<BR ALIGN="LEFT"/>• Resultado: 2.ª economía del<BR ALIGN="LEFT"/>&#160;&#160;&#160;mundo.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="36" VALIGN="MIDDLE"><FONT POINT-SIZE="17" COLOR="#B3261E">→</FONT><BR/><FONT POINT-SIZE="8" COLOR="#B3261E"><I>genera</I></FONT></TD><TD PORT="lim" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E8AFA8" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="231"><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>pp. 29, 36–37</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#B3261E"><B>Límites del modelo</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Desaceleración y deuda excesiva.<BR ALIGN="LEFT"/>• <B>Sobrecapacidad</B> desde 2006 y gasto<BR ALIGN="LEFT"/>&#160;&#160;&#160;ineficiente.<BR ALIGN="LEFT"/>• Presión sobre recursos y ambiente.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="45" VALIGN="MIDDLE"><FONT POINT-SIZE="17" COLOR="#B3261E">→</FONT><BR/><FONT POINT-SIZE="8" COLOR="#B3261E"><I>obliga a</I></FONT></TD><TD PORT="res" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E8AFA8" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="231"><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>pp. 36–38</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#B3261E"><B>Reestructuración · 13.º Plan</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• De inversión fija → consumo,<BR ALIGN="LEFT"/>&#160;&#160;&#160;servicios e innovación (2016–2020).<BR ALIGN="LEFT"/>• La industria con sobrecapacidad<BR ALIGN="LEFT"/>&#160;&#160;&#160;debe buscar mercados fuera.</FONT><BR ALIGN="LEFT"/></TD><TD WIDTH="59" VALIGN="MIDDLE"><FONT POINT-SIZE="17" COLOR="#B3261E">→</FONT><BR/><FONT POINT-SIZE="8" COLOR="#B3261E"><I>se canaliza</I></FONT></TD><TD PORT="val" STYLE="rounded" BGCOLOR="white" BORDER="1" COLOR="#E8AFA8" CELLPADDING="7" VALIGN="TOP" ALIGN="LEFT" BALIGN="LEFT" WIDTH="244"><FONT POINT-SIZE="9" COLOR="#B3261E"><B>①</B></FONT><FONT POINT-SIZE="9" COLOR="#8A8F98"><I>   pp. 37–38</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#C8102E"><B>OBOR, válvula de salida</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="3"> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11.5" COLOR="#262A31">• Exporta acero, cemento y capital a<BR ALIGN="LEFT"/>&#160;&#160;&#160;obras en el exterior.<BR ALIGN="LEFT"/>• Sostiene empleo y PIB; impulsa<BR ALIGN="LEFT"/>&#160;&#160;&#160;regiones fronterizas.</FONT><BR ALIGN="LEFT"/></TD><TD PORT="R" WIDTH="1" HEIGHT="1" FIXEDSIZE="TRUE"></TD></TR></TABLE>>];
