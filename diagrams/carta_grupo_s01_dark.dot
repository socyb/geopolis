  titulo [ label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="CENTER"><FONT FACE="IBM Plex Mono" POINT-SIZE="10" COLOR="#ff5573">SESIÓN 01 · MESA DE BRÚJULAS · 18 DE AGOSTO DE 2026</FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="6"><FONT FACE="Fraunces" POINT-SIZE="34" COLOR="#eef3f9"><B>La carta del grupo</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Space Grotesk" POINT-SIZE="13" COLOR="#c3cede">Tus 28 brújulas, puestas una encima de otra.</FONT></TD></TR></TABLE>>, pos="0,306!", shape="plaintext", style="", fillcolor="none" ];
