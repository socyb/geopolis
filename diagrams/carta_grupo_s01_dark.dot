  hallazgo [ label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="CENTER" CELLPADDING="3"><FONT FACE="IBM Plex Mono" POINT-SIZE="9" COLOR="#7aa2ff">LO QUE ENSEÑA EL SUR DE LA CARTA</FONT></TD></TR><TR><TD ALIGN="CENTER" BALIGN="CENTER"><FONT FACE="Space Grotesk" POINT-SIZE="13" COLOR="#eef3f9">Europa y China encabezan las regiones que decimos seguir, y no aparecen en ninguna de las noticias que trajimos.<BR/>América Latina y México casi no se siguen, y ahí ocurrió un tercio de lo que traíamos en la cabeza.</FONT></TD></TR></TABLE>>, pos="0,-544!", shape="box", penwidth="2", color="#7aa2ff", fillcolor="#15243f" ];
