/* ═══════════════════════════════════════════════════════════════════
   CAPÍTULO 3 (primera parte) · LOS SIETE INSTRUMENTOS (pp. 49–87)
   Blackwill, R. D., y Harris, J. M. (2016). War by other means:
   Geoeconomics and statecraft. Belknap Press of Harvard University Press.
   
   Cada tarjeta amarilla es un instrumento, con sus casos.
   Las dotaciones que deciden si funcionan están en el esquema 3B.

   Código de color (el mismo en los tres esquemas):
     rojo farol ........ idea central
     amarillo yema ..... los platillos: puntos (cap. 1) e instrumentos (cap. 3)
     verde formica ..... dotaciones geoeconómicas (lo estructural)
     café con leche .... casos y ejemplos, con año y página
     azul azulejo ...... autores con los que discuten
     blanco con rojo ... citas textuales (traducción propia)
     gris .............. lo que queda fuera de la geoeconomía
     naranja ........... preguntas abiertas y tensiones
     rosa cartulina .... PUENTES: conexiones mías con otros temas (no son del libro)

   Se dibuja con:  dot -Tsvg cap3a_siete_instrumentos.dot -o cap3a_siete_instrumentos.svg
   Fuentes: Oswald, Barlow Condensed, Courier Prime, Permanent Marker
   (si no están instaladas, Graphviz usa otras y las cajas se descuadran)
   ═══════════════════════════════════════════════════════════════════ */

digraph cap3a_siete_instrumentos {
  graph [ bgcolor="#FBF1DC", pad="0.3", nodesep="0.2", ranksep="0.28",
          fontname="Oswald Bold", labelloc="t", label=<<FONT FACE="Oswald Bold" POINT-SIZE="28" COLOR="#C8102E">Cap. 3 · La carta: siete instrumentos geoeconómicos</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="15" COLOR="#4A2C1D">Blackwill y Harris (2016), War by Other Means, pp. 49–87 · cada instrumento con sus casos</FONT><BR/> >,
          newrank="true", compound="true" ];
  node  [ shape="plain" ];
  edge  [ color="#4A2C1D", penwidth="1.8", arrowsize="0.8" ];

  // ── Arriba: epígrafe y centro ─────────────────────────────────────
  epi [label=<<TABLE BORDER="3" COLOR="#C8102E" BGCOLOR="#FFFFFF" CELLBORDER="0" CELLPADDING="5" CELLSPACING="0" STYLE="rounded"><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="14" COLOR="#C8102E">Epígrafe</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#C8102E">  p. 49</FONT><BR/><FONT FACE="Barlow Condensed Medium Italic" POINT-SIZE="13.5" COLOR="#3B2418">«La política monetaria es política<BR/>exterior […] no solo es política<BR/>interna, sino definitivamente también<BR/>política exterior.» — Helmut Schmidt</FONT></TD></TR></TABLE>>];
  centro [label=<<TABLE BORDER="4" COLOR="#6E0B16" BGCOLOR="#C8102E" CELLBORDER="0" CELLPADDING="5" CELLSPACING="0" STYLE="rounded"><TR><TD BGCOLOR="#C8102E" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="24" COLOR="#FFE08A">SIETE INSTRUMENTOS</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#FFE08A">  p. 49</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="14" COLOR="#FFFFFF">No es la primera era geoeconómica (ahí está el Plan<BR/>Marshall), pero el paisaje cambió: el ciber no existía,<BR/>la energía es casi nueva, la ayuda tiene jugadores<BR/>nuevos. De cada herramienta se mide solo lo geopolítico.</FONT></TD></TR></TABLE>>];
  nota [label=<<TABLE BORDER="3" COLOR="#6B675F" BGCOLOR="#FFFDF6" CELLBORDER="0" CELLPADDING="5" CELLSPACING="0" STYLE="rounded"><TR><TD BGCOLOR="#FFFDF6" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="14" COLOR="#3A3833">Cómo leer esta carta</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="13" COLOR="#3A3833">Amarillo: el instrumento. Café con<BR/>leche: casos. Blanco: citas. Gris:<BR/>lo que no cuenta. Naranja:<BR/>preguntas. Rosa: puentes míos.</FONT></TD></TR></TABLE>>];
  { rank=same; epi; centro; nota; }
  epi -> centro [style=invis];
  centro -> nota [style=invis];

  // ── ① Política comercial ──────────────────────────────────────────
  i1 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="16" COLOR="#5A1A0A">① Política comercial</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 50–53</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Tradición: el incentivo (las<BR/>QIZ en Jordania y Egipto,<BR/>ligadas a Camp David). Hoy,<BR/>también la coerción.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Los vetos de Rusia</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 50–52</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Vino georgiano y moldavo;<BR/>chocolates ucranianos y<BR/>aduanas lentas (2012: ~500<BR/>mdd de pérdidas); lácteos de<BR/>la UE (2014); flores y queso<BR/>neerlandeses tras el MH17<BR/>(2015).</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Vilna, nov. 2013</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 52</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Ucrania no firma con la UE.<BR/>No fue geopolítica contra<BR/>economía: fueron dos<BR/>geoeconomías, el imán de la<BR/>UE y el tirón coercitivo de<BR/>Moscú.</FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#C8102E">Kirguistán, dic. 2013</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#C8102E">  p. 51</FONT><BR/><FONT FACE="Barlow Condensed Medium Italic" POINT-SIZE="12.5" COLOR="#3B2418">«Ucrania tiene opción;<BR/>nosotros, por desgracia, no<BR/>tenemos mucha alternativa.»</FONT></TD></TR></TABLE>>];

  // ── ② Política de inversión ───────────────────────────────────────
  i2 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="16" COLOR="#5A1A0A">② Política de<BR/>inversión</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 53–58</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">En 2014, el 90 % de los<BR/>flujos entre países ya era<BR/>financiero. Y el Estado es<BR/>dueño: reservas, empresas<BR/>estatales, fondos soberanos,<BR/>bancos.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Comprar reconocimiento</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 56</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Costa Rica rompe con Taiwán<BR/>tras una compra china de 300<BR/>mdd en bonos; en África, los<BR/>que reconocen a Taipéi bajan<BR/>de 13 a 4.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Rusia y Kiev, dic. 2013</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 55</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Un sexto de su fondo<BR/>soberano, «apolítico», va al<BR/>rescate de Ucrania.</FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#C8102E">Gelpern, sobre los fondos<BR/>soberanos</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#C8102E">  p. 56</FONT><BR/><FONT FACE="Barlow Condensed Medium Italic" POINT-SIZE="12.5" COLOR="#3B2418">«La ganancia los moverá…<BR/>hasta que no.»</FONT></TD></TR><TR><TD PORT="pb" BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">La puerta de entrada</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 57</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Filtrar la inversión que<BR/>llega también es arma;<BR/>CFIUS: 193 investigaciones<BR/>(2009–13).</FONT></TD></TR></TABLE>>];

  // ── ③ Sanciones ───────────────────────────────────────────────────
  i3 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="16" COLOR="#5A1A0A">③ Sanciones</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 58–59</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Pesan el tamaño del mercado<BR/>y la cuota global… y los<BR/>nodos de nicho con<BR/>importancia sistémica.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">SWIFT y Lloyd's contra Irán</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 58</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">SWIFT está en Bélgica;<BR/>Lloyd's deja de asegurar la<BR/>gasolina iraní (2010–11).</FONT></TD></TR><TR><TD PORT="pb" BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">El mayor cuello de botella:<BR/>el dólar</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 58–59</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">«O haces negocios en dólares<BR/>o con el país sancionado.»</FONT></TD></TR><TR><TD BGCOLOR="#FFFDF6" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#3A3833">Lecciones</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#3A3833">  p. 59</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#3A3833">Entre adversarios se usan<BR/>más y rinden menos;<BR/>funcionan con metas modestas<BR/>y blancos claros; necesitan<BR/>aliados (el embargo de<BR/>granos de 1980 se quedó sin<BR/>Canadá ni Australia).</FONT></TD></TR></TABLE>>];

  // ── ④ Ciber ───────────────────────────────────────────────────────
  i4 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="16" COLOR="#5A1A0A">④ Ciber</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 59–68</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Es geoeconómico si (1) lo<BR/>patrocina un Estado y (2)<BR/>busca un efecto económico.</FONT></TD></TR><TR><TD PORT="pb" BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">✔ Sí lo son</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 61–67</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Estonia 2007 (bancos); Rio<BR/>Tinto–Chinalco y Coca-<BR/>Cola–Huiyuan (2009); Night<BR/>Dragon; Saudi Aramco 2012<BR/>(30 mil computadoras);<BR/>bancos de EE. UU. (2012) y<BR/>JPMorgan (2014), justo<BR/>después de sanciones.</FONT></TD></TR><TR><TD BGCOLOR="#DEDAD2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4D4A44">✘ No lo son</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4D4A44">  p. 60</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#3A3833">Georgia 2008, Stuxnet, el<BR/>robo de planos del F-35:<BR/>buscan mover un equilibrio<BR/>militar.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Asimetría</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 65–68</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Un Estado contra una empresa<BR/>privada desconcierta la<BR/>respuesta. Separar el<BR/>espionaje de seguridad del<BR/>comercial es «muy<BR/>estadounidense» (Sanger).</FONT></TD></TR></TABLE>>];

  // ── ⑤ Ayuda económica ─────────────────────────────────────────────
  i5 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="16" COLOR="#5A1A0A">⑤ Ayuda económica</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 68–74</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Militar, humanitaria y para<BR/>el desarrollo; el dinero es<BR/>fungible. La más<BR/>interesante: la del<BR/>desarrollo, con donantes<BR/>nuevos.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Ayuda militar con doble<BR/>mensaje</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 69–70</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Arabia Saudita da 3 mil mdd<BR/>a Líbano para armas<BR/>francesas: un aviso a<BR/>Washington. Rusia arma a<BR/>Azerbaiyán y Armenia entra a<BR/>la Unión Aduanera.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">El Golfo apuesta en Egipto</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 71–72</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Qatar con Morsi; Arabia, EAU<BR/>y Kuwait tras su caída (más<BR/>de 20 mil mdd). La ayuda ya<BR/>es el 10 % del PIB egipcio.</FONT></TD></TR><TR><TD PORT="pb" BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Bancos estatales de<BR/>desarrollo</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 73–74</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">China Development Bank (980<BR/>mil mdd; 40 mil mdd a<BR/>Venezuela), BNDES, Banco<BR/>BRICS (100 mil mdd), AIIB.</FONT></TD></TR></TABLE>>];

  // ── ⑥ Finanzas y moneda ───────────────────────────────────────────
  i6 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="16" COLOR="#5A1A0A">⑥ Finanzas y moneda</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 74–85</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">«El poder nacional es<BR/>fundamentalmente financiero»<BR/>(Suri). Tres canales: la<BR/>huella de la moneda,<BR/>endeudarse barato y mover el<BR/>costo de la deuda ajena.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Huella de la moneda</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 76–80</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">El euro como «manto»<BR/>geopolítico (Schmidt, 1978;<BR/>Letonia, 2014). Los<BR/>privilegios del dólar.<BR/>Bélgica-Euroclear: 341 mil<BR/>mdd en bonos de EE. UU. que<BR/>eran de China.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">La deuda ajena</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 80–81</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">«Las monedas débiles hacen<BR/>Estados tímidos» (Kirshner).<BR/>Suez 1956; garantías a<BR/>Israel (1991); el préstamo<BR/>ruso a Ucrania (2013).</FONT></TD></TR><TR><TD PORT="pb" BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">México, 1994</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 82</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Clinton usa el Fondo de<BR/>Estabilización Cambiaria: 20<BR/>mil mdd sin pasar por el<BR/>Congreso.</FONT></TD></TR><TR><TD BGCOLOR="#FFB347" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#5A1A00">¿?</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#5A1A00">  p. 84</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2E1300">¿Por qué sería racional<BR/>gastar 100 mil mdd en armas<BR/>e irracional gastarlos en<BR/>encarecer la deuda de<BR/>Ucrania?</FONT></TD></TR></TABLE>>];

  // ── ⑦ Energía y materias primas ───────────────────────────────────
  i7 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="16" COLOR="#5A1A0A">⑦ Energía y materias<BR/>primas</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 85–87</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Coerción abierta, seguro o<BR/>efecto colateral.</FONT></TD></TR><TR><TD PORT="pb" BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Rusia</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 85–86</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Cortó o amenazó con cortar<BR/>el gas más de 50 veces.<BR/>Gazprom Armenia; Gazprom<BR/>Kirguistán, comprada en 1<BR/>dólar. Carta de Putin a 18<BR/>jefes de Estado (2014).</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">China</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 86</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Veto a las tierras raras<BR/>(2010); sus plataformas<BR/>petroleras son «territorio<BR/>nacional móvil» (2012). El<BR/>apetito también es palanca.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Sin coerción</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 87</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Qatar surte el 85 % del gas<BR/>del Reino Unido: un seguro.<BR/>Arabia «presta» un campo<BR/>petrolero a Baréin.</FONT></TD></TR></TABLE>>];
  { rank=same; i1; i2; i3; i4; i5; i6; i7; }
  i1 -> i2 [style=invis];
  i2 -> i3 [style=invis];
  i3 -> i4 [style=invis];
  i4 -> i5 [style=invis];
  i5 -> i6 [style=invis];
  i6 -> i7 [style=invis];
  centro -> i1 [color="#C8102E"];
  centro -> i2 [color="#C8102E"];
  centro -> i3 [color="#C8102E"];
  centro -> i4 [color="#C8102E"];
  centro -> i5 [color="#C8102E"];
  centro -> i6 [color="#C8102E"];
  centro -> i7 [color="#C8102E"];

  // ── PUENTES (rosa): conexiones con otros temas, no son del libro ────
  b_s15 [label=<<TABLE BORDER="2" COLOR="#C2006B" BGCOLOR="#FF8CC6" CELLBORDER="0" CELLPADDING="5" CELLSPACING="0" STYLE="rounded,dashed"><TR><TD BGCOLOR="#FF8CC6" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Permanent Marker" POINT-SIZE="13" COLOR="#4A0030">Sesión 15 · Apple en<BR/>China</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#3A0026">Entrar al mercado chino<BR/>tiene precio político: Rio<BR/>Tinto, Coca-Cola, Apple.</FONT></TD></TR></TABLE>>];
  b_s10 [label=<<TABLE BORDER="2" COLOR="#C2006B" BGCOLOR="#FF8CC6" CELLBORDER="0" CELLPADDING="5" CELLSPACING="0" STYLE="rounded,dashed"><TR><TD BGCOLOR="#FF8CC6" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Permanent Marker" POINT-SIZE="13" COLOR="#4A0030">Sesión 10 · Farrell y<BR/>Newman</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#3A0026">SWIFT, el dólar y Lloyd's:<BR/>cuellos de botella<BR/>(chokepoints) de manual.</FONT></TD></TR></TABLE>>];
