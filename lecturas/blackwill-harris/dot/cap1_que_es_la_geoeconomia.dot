/* ═══════════════════════════════════════════════════════════════════
   CAPÍTULO 1 · ¿QUÉ ES LA GEOECONOMÍA? (pp. 19–32)
   Blackwill, R. D., y Harris, J. M. (2016). War by other means:
   Geoeconomics and statecraft. Belknap Press of Harvard University Press.
   
   Arriba: el problema, la definición y sus tres partes.
   En medio: los cinco puntos con los que los autores la acotan.
   Abajo, en rosa: puentes con otros temas del curso y de mis lecturas.

   Código de color (el mismo en los tres esquemas):
     rojo farol ........ idea central
     amarillo yema ..... los platillos: puntos (cap. 1) e instrumentos (cap. 3)
     verde formica ..... dotaciones geoeconómicas (lo estructural)
     café con leche .... casos y ejemplos, con año y página
     azul azulejo ...... autores con los que discuten
     blanco con rojo ... citas textuales (traducción propia)
     gris .............. lo que queda fuera de la geoeconomía
     naranja ........... preguntas abiertas y tensiones
     rosa cartulina .... PUENTES: conexiones mías con otros temas (no son del libro)

   Se dibuja con:  dot -Tsvg cap1_que_es_la_geoeconomia.dot -o cap1_que_es_la_geoeconomia.svg
   Fuentes: Oswald, Barlow Condensed, Courier Prime, Permanent Marker
   (si no están instaladas, Graphviz usa otras y las cajas se descuadran)
   ═══════════════════════════════════════════════════════════════════ */

digraph cap1_que_es_la_geoeconomia {
  graph [ bgcolor="#FBF1DC", pad="0.3", nodesep="0.2", ranksep="0.28",
          fontname="Oswald Bold", labelloc="t", label=<<FONT FACE="Oswald Bold" POINT-SIZE="28" COLOR="#C8102E">Cap. 1 · ¿Qué es la geoeconomía?</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="15" COLOR="#4A2C1D">Blackwill y Harris (2016), War by Other Means, pp. 19–32 · una definición en tres partes y cinco precisiones</FONT><BR/> >,
          newrank="true", compound="true" ];
  node  [ shape="plain" ];
  edge  [ color="#4A2C1D", penwidth="1.8", arrowsize="0.8" ];

  // ── Arriba: problema, definición en tres partes, epígrafe y autores ────
  prob [label=<<TABLE BORDER="3" COLOR="#8C877D" BGCOLOR="#DEDAD2" CELLBORDER="0" CELLPADDING="5" CELLSPACING="0" STYLE="rounded,dashed"><TR><TD BGCOLOR="#DEDAD2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="14" COLOR="#4D4A44">El problema</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#4D4A44">  pp. 19–20</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#3A3833">«Geoeconomía» se usa mucho y<BR/>casi nunca se define. Usos<BR/>previos: (a) poder militar para<BR/>fines económicos; (b) cajón de<BR/>sastre, «el enredo de economía<BR/>internacional, geopolítica y<BR/>estrategia»; (c) comercio y<BR/>protección de industrias. En EE.<BR/>UU.: «comercio por el comercio»<BR/>(Angell: el comercio trae la<BR/>paz).</FONT></TD></TR></TABLE>>];
  def [label=<<TABLE BORDER="4" COLOR="#6E0B16" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#C8102E" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="24" COLOR="#FFE08A">GEOECONOMÍA</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#FFE08A">  p. 20</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="13.5" COLOR="#FFFFFF">El uso de instrumentos económicos para promover y defender los<BR/>intereses nacionales y para producir resultados geopolíticos<BR/>benéficos; y los efectos de las acciones económicas de otras<BR/>naciones sobre las metas geopolíticas de un país. Es método de<BR/>análisis y forma de statecraft (arte de gobernar).</FONT></TD></TR><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#5A1A0A">① Promover y defender intereses</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#5A1A0A">  p. 20</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="13.5" COLOR="#2B1B12">Economía interna fuerte → proyección de poder: «importante y<BR/>bien entendido». Ley casi universal: ningún país, por grande<BR/>que sea, aguanta mucho tiempo con cargas geopolíticas mayores<BR/>que su base económica.</FONT></TD></TR><TR><TD PORT="dos" BORDER="3" COLOR="#C8102E" BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#6E0B16">② Producir resultados geopolíticos  ★ FOCO DEL LIBRO</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#6E0B16">  p. 21</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="13.5" COLOR="#2B1B12">Las técnicas económicas del arte de gobernar: lo que más se<BR/>practica y menos se piensa, sobre todo en EE. UU. Se precisa<BR/>con cinco puntos ↓</FONT></TD></TR><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#5A1A0A">③ Efectos de lo que hacen otros</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#5A1A0A">  pp. 20–21</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="13.5" COLOR="#2B1B12">Terreno de la economía política internacional, mirado desde el<BR/>sistema. Ej.: bastó anunciar menos compras de bonos de la Fed<BR/>(taper talk) para encarecer la deuda de Kiev y precipitar la<BR/>caída de Yanukóvich (Steil). El tema volvió con la crisis de<BR/>2008–09 y el ascenso de China.</FONT></TD></TR></TABLE>>];
  epi [label=<<TABLE BORDER="3" COLOR="#C8102E" BGCOLOR="#FFFFFF" CELLBORDER="0" CELLPADDING="5" CELLSPACING="0" STYLE="rounded"><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="14" COLOR="#C8102E">Epígrafe</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#C8102E">  p. 19</FONT><BR/><FONT FACE="Barlow Condensed Medium Italic" POINT-SIZE="13.5" COLOR="#3B2418">«La guerra y el comercio no<BR/>son sino dos medios<BR/>distintos de llegar al mismo<BR/>fin: poseer lo que se<BR/>desea.» — Benjamin Constant</FONT></TD></TR></TABLE>>];
  autores [label=<<TABLE BORDER="3" COLOR="#2C7DA0" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#BFE0EE" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="14" COLOR="#123F55">Autores en la mesa</FONT></TD></TR><TR><TD BGCOLOR="#BFE0EE" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#123F55">Susan Strange, 1970</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#123F55">  pp. 21–22</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#13303D">Pedía estudiar lo económico<BR/>internacional con la política<BR/>por encima de la economía.</FONT></TD></TR><TR><TD BGCOLOR="#BFE0EE" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#123F55">David Baldwin, 1985</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#123F55">  pp. 22–23</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#13303D">Economic Statecraft: «pensar<BR/>sobre pensar» las técnicas<BR/>económicas de gobierno.</FONT></TD></TR><TR><TD BGCOLOR="#BFE0EE" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#123F55">Alan Dobson, 2002</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#123F55">  p. 22</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#13303D">El statecraft económico de EE.<BR/>UU., 1933–1991.</FONT></TD></TR><TR><TD PORT="perdido" BGCOLOR="#BFE0EE" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#123F55">Robert Zoellick · un «arte<BR/>perdido»</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#123F55">  p. 25</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#13303D">150 años de política exterior<BR/>con lógica económica; hoy<BR/>economía y seguridad van por<BR/>separado. ¿Por qué? → cap. 6</FONT></TD></TR><TR><TD BGCOLOR="#FF8CC6" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A0030">Puente · sesión 15</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#3A0026">Strange llevada a Apple en<BR/>China: el poder estructural.</FONT></TD></TR></TABLE>>];
  { rank=same; prob; def; epi; autores; }
  prob -> def [style=invis];
  def -> epi [style=invis];
  epi -> autores [style=invis];

  // ── Los cinco puntos (un solo bloque) ─────────────────────────────
  p1 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="15" COLOR="#5A1A0A">PUNTO 1 · Geoeconomía ≠<BR/>geopolítica</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 23–25</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Clasifican los MEDIOS, no los fines</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 23–24</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Usar la fuerza militar para ganar<BR/>algo económico es geopolítica, no<BR/>geoeconomía.</FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#C8102E">Baldwin</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#C8102E">  p. 23</FONT><BR/><FONT FACE="Barlow Condensed Medium Italic" POINT-SIZE="12.5" COLOR="#3B2418">«Bombardear una biblioteca no se<BR/>llama guerra cultural […] y<BR/>bombardear fábricas no debería<BR/>llamarse guerra económica.»</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Dos relatos paralelos</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 24</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Geopolítica: el poder sobre el<BR/>territorio explicado por factores<BR/>geográficos. Geoeconomía: el mismo<BR/>poder explicado por factores<BR/>económicos.</FONT></TD></TR><TR><TD PORT="logica" BGCOLOR="#C8102E" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#FFE08A">Lógica de la geopolítica +<BR/>herramientas de la economía</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#FFE08A">  pp. 24–25</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#FFFFFF">Geopolítica = suma cero; economía =<BR/>suma positiva (Mandelbaum). Con fines<BR/>geopolíticos, la economía da<BR/>resultados tan de suma cero como la<BR/>guerra.</FONT></TD></TR><TR><TD BGCOLOR="#FFB347" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#5A1A00">¿?</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#5A1A00">  p. 24</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2E1300">¿El auge de la geoeconomía cambia<BR/>cuándo y cómo se usa la fuerza<BR/>militar? (vuelve en el cap. 3, p. 52)</FONT></TD></TR></TABLE>>];
  p2 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="15" COLOR="#5A1A0A">PUNTO 2 · Los medios no dicen<BR/>nada de los fines</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 26–27</FONT></TD></TR><TR><TD BGCOLOR="#DEDAD2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4D4A44">✘ Otro uso: los fines se vuelven<BR/>económicos</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4D4A44">  p. 26</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#3A3833">Luttwak (1990): «la lógica del<BR/>conflicto con los métodos del<BR/>comercio». Airbus contra Boeing:<BR/>conquista industrial en vez de<BR/>territorial. Queda fuera del libro.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Fines mezclados</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 27</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Basta la presencia —no exclusiva— de<BR/>un interés geopolítico importante.<BR/>Ej.: las inversiones chinas en<BR/>África.</FONT></TD></TR><TR><TD PORT="diseno" BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">El diseño delata la intención</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 27</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Un tratado comercial pensado para la<BR/>política exterior se ve distinto de<BR/>uno puramente económico (→ cap. 7).</FONT></TD></TR><TR><TD BGCOLOR="#BFE0EE" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#123F55">Luttwak sobre China</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#123F55">  p. 22</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#13303D">La resistencia a su ascenso será<BR/>geoeconómica: barreras, vetos a<BR/>inversión y tecnología, materias<BR/>primas.</FONT></TD></TR></TABLE>>];
  p3 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="15" COLOR="#5A1A0A">PUNTO 3 · Muchas formas,<BR/>capacidades desiguales</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 27–28</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Cuatro ejes</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 27</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">positiva ↔ coercitiva · corto ↔ largo<BR/>plazo · transaccional ↔ general · paz<BR/>↔ guerra</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Golpes dirigidos</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 27–28</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">Embargo de granos de Carter a la URSS<BR/>por Afganistán (1979–80); préstamos<BR/>de Truman a los aliados.</FONT></TD></TR><TR><TD BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">Jugadas largas · En medio</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  p. 28</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">La moneda única que impulsó la RFA y<BR/>la propia UE. Qatar mete 8 mil mdd en<BR/>Egipto entre la caída de Mubarak y la<BR/>de Morsi (2011–13).</FONT></TD></TR><TR><TD BGCOLOR="#9FD8C0" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#0E3B2D">DOTACIONES GEOECONÓMICAS</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#0E3B2D">  p. 28</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#11251E">Rasgos estructurales que hacen a un<BR/>país más o menos eficaz con estas<BR/>herramientas → cap. 3</FONT></TD></TR><TR><TD PORT="preg" BGCOLOR="#FFB347" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#5A1A00">¿?</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#5A1A00">  p. 28</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2E1300">¿Las no democracias están mejor<BR/>dotadas? ¿Los países pequeños pierden<BR/>igual que en geopolítica?</FONT></TD></TR></TABLE>>];
  p4 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="15" COLOR="#5A1A0A">PUNTO 4 · Hay casos borrosos</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 28–30</FONT></TD></TR><TR><TD PORT="adentro" BGCOLOR="#EAD3B2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4A2C1D">✔ ADENTRO</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4A2C1D">  pp. 29–30</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#2B1B12">• Bloqueo económico con apoyo naval:<BR/>caso híbrido; la variable es la<BR/>negación económica.<BR/>• Ciberataque a bancos o a<BR/>infraestructura económica.<BR/>• Falsificar la moneda del enemigo en<BR/>guerra.<BR/>• Ayuda militar y humanitaria: el<BR/>dinero es fungible.</FONT></TD></TR><TR><TD BGCOLOR="#DEDAD2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4D4A44">✘ AFUERA</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4D4A44">  pp. 28–29</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#3A3833">• Bombardear una fábrica: toca a las<BR/>normas de la guerra, no a la<BR/>economía.<BR/>• Ciberataques contra blancos<BR/>militares o de gobierno.</FONT></TD></TR><TR><TD BGCOLOR="#FFFDF6" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#3A3833">Moraleja</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#3A3833">  p. 30</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#3A3833">Que haya casos dudosos habla de<BR/>circunstancias enredadas, no de una<BR/>mala definición.</FONT></TD></TR></TABLE>>];
  p5 [label=<<TABLE BORDER="3" COLOR="#8A5A00" BGCOLOR="#FFF8E7" CELLBORDER="0" CELLPADDING="5" CELLSPACING="3" STYLE="rounded"><TR><TD BGCOLOR="#F6C945" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Bold" POINT-SIZE="15" COLOR="#5A1A0A">PUNTO 5 · Ni política económica<BR/>exterior, ni mercantilismo, ni<BR/>liberalismo</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="11" COLOR="#5A1A0A">  pp. 30–32</FONT></TD></TR><TR><TD BGCOLOR="#DEDAD2" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#4D4A44">Política económica exterior</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#4D4A44">  p. 30</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#3A3833">Quiere influir en el entorno<BR/>económico, no en el geopolítico<BR/>(Cohen y Pastor); S. Cohen la quiere<BR/>lejos de la política exterior.</FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#C8102E">Adam Smith</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#C8102E">  p. 31</FONT><BR/><FONT FACE="Barlow Condensed Medium Italic" POINT-SIZE="12.5" COLOR="#3B2418">«La defensa es más importante que la<BR/>opulencia». La riqueza del vecino es<BR/>ventajosa en el comercio y «peligrosa<BR/>en la guerra y la política».</FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#C8102E">Cobden, según Hinsley</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#C8102E">  p. 32</FONT><BR/><FONT FACE="Barlow Condensed Medium Italic" POINT-SIZE="12.5" COLOR="#3B2418">«Trabajó por el libre comercio porque<BR/>quería la paz, no por la paz porque<BR/>quería el libre comercio».</FONT></TD></TR><TR><TD PORT="sabores" BGCOLOR="#C8102E" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Oswald Medium" POINT-SIZE="12.5" COLOR="#FFE08A">Dos sabores de geoeconomía</FONT><FONT FACE="Courier Prime Bold" POINT-SIZE="10.5" COLOR="#FFE08A">  pp. 31–32</FONT><BR/><FONT FACE="Barlow Condensed Medium" POINT-SIZE="12.5" COLOR="#FFFFFF">Mercantilismo y liberalismo difieren<BR/>en el CÓMO, no en el SI: los dos<BR/>ponen la economía al servicio del<BR/>Estado (Baldwin, Gilpin, Earle).</FONT></TD></TR></TABLE>>];
  subgraph cluster_puntos {
    style="rounded,filled"; fillcolor="#FFF1C2"; color="#C99A1E"; penwidth="2"; margin="12";
    label=<<FONT FACE="Oswald Bold" POINT-SIZE="17" COLOR="#6E0B16">Cinco puntos para acotar la definición</FONT>>; labeljust="l";
    p1; p2; p3; p4; p5;
  }
  { rank=same; p1; p2; p3; p4; p5; }
  p1 -> p2 [style=invis];
  p2 -> p3 [style=invis];
  p3 -> p4 [style=invis];
  p4 -> p5 [style=invis];
  def:dos -> p3 [label=<<FONT FACE="Oswald Medium" POINT-SIZE="12" COLOR="#6E0B16">precisa</FONT>>, color="#C8102E", penwidth="4", lhead="cluster_puntos"];
  prob -> p1 [style="invis"];
  autores -> p5 [style="invis"];

  // ── PUENTES (rosa): conexiones con otros temas, no son del libro ────
